{
  "name": "localguy",
  "version": "1.0.0",
  "description": "Obsidian-first IndieWeb publishing stack",
  "scripts": {
    "dev": "npx @11ty/eleventy --serve",
    "build": "ELEVENTY_ENV=production npx @11ty/eleventy && npx pagefind --site _site",
    "clean": "rm -rf _site",
    "smart-retag": ".venv/bin/python scripts/smart-retag.py",
    "smart-retag:drafts": ".venv/bin/python scripts/smart-retag.py --drafts-only",
    "smart-retag:dry": ".venv/bin/python scripts/smart-retag.py --dry-run",
    "clinic:index": "node scripts/clinic-index.js",
    "generate-summaries": "node scripts/generate-summaries.js",
    "generate-summaries:force": "node scripts/generate-summaries.js --force",
    "retag-and-summarize": "npm run smart-retag:drafts && npm run generate-summaries",
    "tag-manager": "node scripts/tag-manager/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@upstash/redis": "^1.36.2",
    "@upstash/vector": "^1.2.2",
    "@vercel/analytics": "^1.6.1",
    "dotenv": "^17.3.1",
    "markdown-it-obsidian-callouts": "^0.3.3",
    "markdown-it-wikilinks": "^1.4.0"
  },
  "devDependencies": {
    "express": "^5.2.1",
    "pagefind": "^1.4.0"
  }
}
