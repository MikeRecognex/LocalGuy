---
title: "All Posts"
layout: layouts/base.njk
permalink: /posts/
---

<h1>All Posts</h1>

<p class="submit-link">Have something to share? <a href="/contribute/">Submit a post</a></p>

{%- set weeks = collections.posts | groupByWeek %}

{%- if weeks.length %}
{%- for week in weeks %}
  <details class="week-group">
    <summary class="week-header">
      <span class="week-label">{{ week.weekLabel }}</span>
      <span class="week-count">{{ week.postCount }} post{{ "s" if week.postCount != 1 }}</span>
    </summary>

    {%- set ws = summaries.weekly[week.weekKey] %}
    {%- if ws %}
    <div class="week-summary">{{ (ws.text if ws.text else ws) | safe }}</div>
    {%- endif %}

    {%- for day in week.days %}
    <details class="day-group">
      <summary class="day-header">
        <span class="day-label">{{ day.dateKey | shortDate }}</span>
        {%- set ds = summaries.daily[day.dateKey] %}
        {%- if ds %}
        <span class="day-highlight">{{ ds.text if ds.text else ds }}</span>
        {%- endif %}
      </summary>
      <ul class="post-list">
        {%- for post in day.posts %}
        <li>
          <a href="{{ post.url }}">{{ post.data.title }}</a>
          {% if post.data.tags %}<div class="post-tags">{%- for tag in post.data.tags | topicTags %}<a href="/tags/{{ tag }}/">#{{ tag }}</a>{%- endfor %}</div>{% endif %}
          {% if post.data.description %}<p class="summary">{{ post.data.description }}</p>{% endif %}
        </li>
        {%- endfor %}
      </ul>
    </details>
    {%- endfor %}
  </details>
{%- endfor %}
{%- endif %}

<script src="/js/posts-accordion.js"></script>
