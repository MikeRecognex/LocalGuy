---
pagination:
  data: collections.tagPages
  size: 1
  alias: tag
  # Without this Eleventy puts only the first paginated page into collections.all,
  # so the sitemap listed 1 of 1,113 tag pages. Nothing else iterates collections.all.
  addAllPagesToCollections: true
permalink: /tags/{{ tag.slug }}/
eleventyComputed:
  title: "{{ tag.title }}"
  description: "{{ tag.description }}"
layout: layouts/base.njk
---

<h1>Tagged "{{ tag.slug }}"</h1>

<p class="tag-intro">{{ tag.posts.length }} articles tagged <strong>{{ tag.slug }}</strong>, {{ tag.posts[0].date | readableDate }} to {{ tag.latest | readableDate }}. Newest first.</p>

<ul class="post-list">
{% for post in tag.posts | reverse %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title or "Note" }}</a>
    <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
    {% if post.data.description %}<p class="summary">{{ post.data.description }}</p>{% endif %}
  </li>
{% endfor %}
</ul>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ tag.title | dump | safe }},
  "description": {{ tag.description | dump | safe }},
  "url": "{{ site.url }}{{ page.url }}",
  "inLanguage": {{ site.language | dump | safe }},
  "isPartOf": { "@type": "WebSite", "name": {{ site.name | dump | safe }}, "url": "{{ site.url }}" },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ tag.posts.length }},
    "itemListElement": [
      {%- for post in tag.posts | reverse %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "url": "{{ site.url }}{{ post.url }}",
        "name": {{ (post.data.title or "Note") | dump | safe }}
      }{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
}
</script>
