{%- set canonical = canonical_url or (site.url + page.url) -%}
{%- set pageTitle = title or site.name -%}
{%- set pageDesc = description or site.description -%}
{%- set pageImage = site.url + "/assets/" + (image if image else "og-default.png") -%}
{%- set isArticle = layout == "layouts/post.njk" or layout == "layouts/guide.njk" -%}
<link rel="canonical" href="{{ canonical }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:type" content="{% if isArticle %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:image" content="{{ pageImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{%- if isArticle %}
<meta property="article:published_time" content="{{ date | isoDate }}">
{%- if updated %}
<meta property="article:modified_time" content="{{ updated | isoDate }}">
{%- endif %}
{%- if tags %}
{%- for tag in tags %}
{%- if tag != "posts" and tag != "guides" %}
<meta property="article:tag" content="{{ tag }}">
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="{{ site.twitterHandle }}">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ pageImage }}">
{%- if isArticle %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ pageDesc | dump | safe }},
  "image": "{{ pageImage }}",
  "datePublished": "{{ date | isoDate }}",
  {%- if updated %}
  "dateModified": "{{ updated | isoDate }}",
  {%- else %}
  "dateModified": "{{ date | isoDate }}",
  {%- endif %}
  "author": {
    "@type": "Person",
    "name": {{ site.author | dump | safe }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ site.name | dump | safe }},
    "url": "{{ site.url }}"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ canonical }}"
  }
}
</script>
{%- elif page.url == "/" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ site.name | dump | safe }},
  "description": {{ site.description | dump | safe }},
  "url": "{{ site.url }}"
}
</script>
{%- endif %}
