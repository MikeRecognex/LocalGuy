{%- set canonical = canonical_url or (site.url + page.url) -%}
{%- set pageTitle = title or site.name -%}
{%- set pageDesc = description or site.description -%}
{%- set pageImage = site.url + "/assets/" + (image if image else "og-default.png") -%}
{%- set isPost = layout == "layouts/post.njk" -%}
{%- set isGuide = layout == "layouts/guide.njk" -%}
{%- set isArticle = isPost or isGuide -%}
<link rel="canonical" href="{{ canonical }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:type" content="{% if isArticle %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:image" content="{{ pageImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{%- if isArticle %}
<meta property="article:published_time" content="{{ date | isoDate }}">
{%- if updated %}
<meta property="article:modified_time" content="{{ updated | isoDate }}">
{%- endif %}
{%- if tags %}
{%- for tag in tags %}
{%- if tag != "posts" and tag != "guides" %}
<meta property="article:tag" content="{{ tag }}">
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="{{ site.twitterHandle }}">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ pageImage }}">
{%- if isArticle %}
{#- Guides are evergreen how-tos, posts are dated news notes. The distinction is
    editorially load-bearing (see /llms.txt), so it is typed rather than flattened
    into a generic Article. topicTags drops the classifier tags — audience and
    sentiment labels are not keywords. -#}
{%- set topics = tags | topicTags if tags else [] -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "{% if isGuide %}TechArticle{% else %}NewsArticle{% endif %}",
  "headline": {{ title | dump | safe }},
  "description": {{ pageDesc | dump | safe }},
  "image": "{{ pageImage }}",
  "inLanguage": {{ site.language | dump | safe }},
  "isAccessibleForFree": true,
  "datePublished": "{{ date | isoDate }}",
  "dateModified": "{{ (updated or date) | isoDate }}",
  {%- if topics.length %}
  "keywords": {{ topics | dump | safe }},
  {%- endif %}
  {%- if isGuide and difficulty %}
  "proficiencyLevel": {{ difficulty | dump | safe }},
  {%- endif %}
  {%- if isPost and source.url %}
  "isBasedOn": {
    "@type": "WebPage",
    "url": {{ source.url | dump | safe }}
    {%- if source.name -%}
    , "publisher": { "@type": "Organization", "name": {{ source.name | dump | safe }} }
    {%- endif %}
  },
  {%- endif %}
  {%- if isPost and mentions.length %}
  "mentions": [
    {%- for m in mentions %}
    {
      "@type": "{% if m.role == 'author' %}Person{% else %}Organization{% endif %}",
      "name": {{ m.name | dump | safe }}
      {%- if m.url -%}
      , "url": {{ m.url | dump | safe }}
      {%- elif m.handle -%}
      , "url": {{ ("https://x.com/" + (m.handle | replace("@", ""))) | dump | safe }}
      {%- endif %}
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ],
  {%- endif %}
  "author": {
    "@type": "Person",
    "name": {{ site.author | dump | safe }},
    "url": "{{ site.url }}/about/",
    "sameAs": ["https://x.com/{{ site.twitterHandle | replace('@', '') }}", {{ site.authorLinkedIn | dump | safe }}]
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ site.name | dump | safe }},
    "url": "{{ site.url }}"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ canonical }}"
  }
}
</script>
{%- elif page.url == "/" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ site.name | dump | safe }},
  "description": {{ site.description | dump | safe }},
  "url": "{{ site.url }}"
}
</script>
{%- endif %}
