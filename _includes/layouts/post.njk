---
layout: layouts/base.njk
---
<article class="h-entry">
  <header>
    {% if image %}
    <img src="/assets/{{ image }}" alt="{{ title }}" class="hero-image">
    {% endif %}
    <h1 class="p-name">{{ title }}</h1>
    <time class="dt-published" datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
    <span class="reading-time">{{ content | readingTime }}</span>
    {% if tags %}
    <div class="tags">
      {%- for tag in tags | linkableTags %}
        <a href="/tags/{{ tag | lower }}/" rel="tag">#{{ tag }}</a>
      {%- endfor %}
    </div>
    {% endif %}
    {% if mentions %}
    <div class="mentions">
      {%- for mention in mentions %}
        <span class="mention-chip">
          {%- if mention.handle %}
            <a href="https://x.com/{{ mention.handle | replace('@', '') }}" rel="nofollow">{{ mention.name }}</a>
          {%- elif mention.url %}
            <a href="{{ mention.url }}" rel="nofollow">{{ mention.name }}</a>
          {%- else %}
            {{ mention.name }}
          {%- endif %}
          {%- if mention.role %}<small>{{ mention.role }}</small>{%- endif %}
        </span>
      {%- endfor %}
    </div>
    {% endif %}
  </header>

  <div class="e-content">
    {{ content | safe }}
  </div>

  <footer>
    <a class="u-url" href="{{ page.url }}">Permalink</a>
    <span class="p-author h-card" hidden>
      <a class="u-url p-name" href="{{ site.url }}">{{ site.author }}</a>
    </span>
  </footer>
</article>

{# Outside <article> deliberately: these links are navigation about the post, not part
   of its h-entry content, and nesting them would fold other posts' titles into this
   one's microformat payload and its e-content. #}
{% set related = page.url | relatedTo %}
{% if related.length %}
<nav class="related-posts" aria-labelledby="related-posts-heading">
  <h2 id="related-posts-heading">Related posts</h2>
  <ul>
    {%- for post in related %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
    </li>
    {%- endfor %}
  </ul>
</nav>
{% endif %}

{% include "partials/comments.njk" %}
