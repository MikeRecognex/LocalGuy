---
layout: layouts/base.njk
---
<article class="h-entry">
  <header>
    {% if image %}
    <img src="/assets/{{ image }}" alt="{{ title }}" class="hero-image">
    {% endif %}
    <h1 class="p-name">{{ title }}</h1>
    <time class="dt-published" datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
    <span class="reading-time">{{ content | readingTime }}</span>
    {% if tags %}
    <div class="tags">
      {%- for tag in tags | linkableTags %}
        <a href="/tags/{{ tag | lower }}/" rel="tag">#{{ tag }}</a>
      {%- endfor %}
    </div>
    {% endif %}
    {% if mentions %}
    <div class="mentions">
      {%- for mention in mentions %}
        <span class="mention-chip">
          {%- if mention.handle %}
            <a href="https://x.com/{{ mention.handle | replace('@', '') }}" rel="nofollow">{{ mention.name }}</a>
          {%- elif mention.url %}
            <a href="{{ mention.url }}" rel="nofollow">{{ mention.name }}</a>
          {%- else %}
            {{ mention.name }}
          {%- endif %}
          {%- if mention.role %}<small>{{ mention.role }}</small>{%- endif %}
        </span>
      {%- endfor %}
    </div>
    {% endif %}
  </header>

  <div class="e-content">
    {{ content | safe }}
  </div>

  <footer>
    <a class="u-url" href="{{ page.url }}">Permalink</a>
    <span class="p-author h-card" hidden>
      <a class="u-url p-name" href="{{ site.url }}">{{ site.author }}</a>
    </span>
  </footer>
</article>

{% include "partials/comments.njk" %}
