<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  {% include "partials/meta.njk" %}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="/feed.xml">
  <link rel="alternate" type="application/json" title="{{ site.name }}" href="/feed.json">
  <link rel="preconnect" href="https://giscus.app" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  {% include "partials/header.njk" %}

  <main>
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/search.njk" %}
  <script type="module" src="/js/search.js"></script>
  {% if page.url == "/bookmarks/" %}<script type="module" src="/js/bookmarks.js"></script>{% endif %}
  {# Both pages that embed partials/ask-form.njk. This said "/clinic/" after the
     page moved to /ask/ in 837b5779, so the form rendered with nothing bound to
     it and the button did nothing. Keep this list in step with the partial. #}
  {% if page.url == "/ask/" or page.url == "/" %}<script type="module" src="/js/clinic.js"></script>{% endif %}
  {% if page.url == "/trends/" %}<script type="module" src="/js/trends.js"></script>{% endif %}
  {% if page.url == "/graph/" %}<script type="module" src="/js/graph.js"></script><script type="module" src="/js/trends.js"></script>{% endif %}
  {% if page.url == "/" %}<script type="module" src="/js/graph.js"></script>{% endif %}
  <script defer src="/_vercel/insights/script.js"></script>
  {# Records external referrals and engaged visits to /api/referrer. Vercel's
     own analytics will not retain referrers long enough to compare across
     months, and its visitor count cannot separate people from automation — its
     analytics is itself a client script, so the traffic inflating the count is
     already executing JavaScript. Reading behaviour is the part that is
     expensive to fake, so an engaged visit is recorded only after someone
     scrolls, clicks, or stays.

     Sends the referring hostname only, never the full URL, which can carry the
     visitor's own search terms. Inline to avoid a request, sendBeacon so it
     never delays a page, and silent on every failure. #}
  <script>
    (function () {
      var send = function (payload) {
        try {
          if (!navigator.sendBeacon) return;
          navigator.sendBeacon('/api/referrer', new Blob([JSON.stringify(payload)], {
            type: 'application/json'
          }));
        } catch (e) { /* never let analytics break a page */ }
      };

      try {
        if (document.referrer) {
          var host = new URL(document.referrer).hostname;
          if (host && host !== location.hostname) {
            send({ ref: host, path: location.pathname });
          }
        }
      } catch (e) { /* ignore */ }

      // One engagement ping per page, and only on an input a reader actually
      // makes. An earlier version also fired on a bare 15s timer, which counted
      // anything that loaded a page and waited — the result was 140 pages with
      // exactly one "engaged" visit each and none with two, which is a crawl
      // pattern, not an audience. A dwell timer cannot tell reading from a tab
      // left open by automation, so there is no timer here.
      //
      // This undercounts: someone who reads a short post without scrolling is
      // missed. That is the right direction to be wrong in, since the number
      // exists to separate people from automation.
      var fired = false;
      var engaged = function () {
        if (fired) return;
        fired = true;
        cleanup();
        send({ type: 'engaged', path: location.pathname });
      };
      var onScroll = function () { if (window.scrollY > 200) engaged(); };
      var onMove = function (e) {
        // A single synthetic jump is not a mouse being moved by a hand.
        if (typeof e.movementX !== 'number') return engaged();
        if (Math.abs(e.movementX) + Math.abs(e.movementY) > 0) engaged();
      };
      var cleanup = function () {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('click', engaged);
        window.removeEventListener('keydown', engaged);
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('touchstart', engaged);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('click', engaged, { passive: true });
      window.addEventListener('keydown', engaged, { passive: true });
      window.addEventListener('pointermove', onMove, { passive: true });
      window.addEventListener('touchstart', engaged, { passive: true });
    })();
  </script>
</body>
</html>
