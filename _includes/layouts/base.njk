<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  {% include "partials/meta.njk" %}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="/feed.xml">
  <link rel="alternate" type="application/json" title="{{ site.name }}" href="/feed.json">
  <link rel="preconnect" href="https://giscus.app" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  {% include "partials/header.njk" %}

  <main>
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/search.njk" %}
  <script type="module" src="/js/search.js"></script>
  {% if page.url == "/bookmarks/" %}<script type="module" src="/js/bookmarks.js"></script>{% endif %}
  {# Both pages that embed partials/ask-form.njk. This said "/clinic/" after the
     page moved to /ask/ in 837b5779, so the form rendered with nothing bound to
     it and the button did nothing. Keep this list in step with the partial. #}
  {% if page.url == "/ask/" or page.url == "/" %}<script type="module" src="/js/clinic.js"></script>{% endif %}
  {% if page.url == "/trends/" %}<script type="module" src="/js/trends.js"></script>{% endif %}
  {% if page.url == "/graph/" %}<script type="module" src="/js/graph.js"></script><script type="module" src="/js/trends.js"></script>{% endif %}
  {% if page.url == "/" %}<script type="module" src="/js/graph.js"></script>{% endif %}
  <script defer src="/_vercel/insights/script.js"></script>
  {# Records external referrals to /api/referrer, which Vercel's own analytics
     will not retain long enough to compare across months. Sends the referring
     hostname only, never the full URL, which can carry the visitor's search
     terms. Inline to avoid a request, and silent on every failure — a missed
     referral must never surface to a reader. #}
  <script>
    (function () {
      try {
        if (!document.referrer || !navigator.sendBeacon) return;
        var host = new URL(document.referrer).hostname;
        if (!host || host === location.hostname) return;
        navigator.sendBeacon('/api/referrer', new Blob([JSON.stringify({
          ref: host,
          path: location.pathname
        })], { type: 'application/json' }));
      } catch (e) { /* never let analytics break a page */ }
    })();
  </script>
</body>
</html>
